# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# JWT (httpOnly cookies)
JWT_ADMIN_SECRET=change-me-admin-secret
JWT_STUDENT_SECRET=change-me-student-secret
JWT_ADMIN_EXPIRES=8h
JWT_STUDENT_EXPIRES=7d

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=school
MYSQL_PASSWORD=school
MYSQL_DATABASE=school_store
MYSQL_ROOT_PASSWORD=root

# Seed super admin
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=Admin@12345

# Optional Cloudinary (leave empty to use local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay stub (not required for COD / pay-at-school)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
