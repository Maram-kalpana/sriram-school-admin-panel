# Copy to admin-panel/server/.env (or set these when running the API).
# See admin-panel/server/.env.example for the full list.

PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=scholar
DB_PASSWORD=scholar
DB_NAME=scholar_store
JWT_SECRET=change-me-to-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
ADMIN_SEED_EMAIL=admin@scholarstore.local
ADMIN_SEED_PASSWORD=Admin@12345
STOREFRONT_API_KEY=change-me-storefront-api-key
UPLOAD_DIR=uploads

# 64 hex chars = 32 bytes (AES-256-GCM for Paytm key / SMTP password)
SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Public API origin used to build the Paytm callback URL
API_BASE_URL=http://localhost:4000
