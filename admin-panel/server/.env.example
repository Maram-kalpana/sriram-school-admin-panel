NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=scholar
DB_PASSWORD=scholar
DB_NAME=scholar_store

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173

# Seed super admin
ADMIN_SEED_EMAIL=admin@scholarstore.local
ADMIN_SEED_PASSWORD=Admin@12345
ADMIN_SEED_NAME=Super Admin

# Storefront API (x-api-key header)
STOREFRONT_API_KEY=change-me-storefront-api-key

# Uploads (relative to server cwd, or absolute path)
UPLOAD_DIR=uploads
